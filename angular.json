{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "expense-tracker-fe": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "assets",
                "output": "/assets"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "src/styles.scss"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "serviceWorker": "ngsw-config.json",
            "security": {
              "allowedHosts": [
                "localhost",
                "127.0.0.1",
                "expense-tracker-fe-o0wf.onrender.com",
                "3f8tx9ph-4200.inc1.devtunnels.ms"
              ]
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "optimization": {
                "fonts": false
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "24kB",
                  "maximumError": "48kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "expense-tracker-fe:build:production"
            },
            "development": {
              "buildTarget": "expense-tracker-fe:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest",
            "include": [
              "src/app/core/services/*.spec.ts",
              "src/app/core/guards/*.spec.ts",
              "src/app/core/interceptors/*.spec.ts",
              "src/app/core/shared/utils/*.spec.ts"
            ],
            "coverage": true,
            "coverageReporters": [
              "text",
              "text-summary",
              "html",
              "lcov",
              "json-summary"
            ],
            "coverageInclude": [
              "src/app/core/services/api.ts",
              "src/app/core/services/auth.ts",
              "src/app/core/services/config.ts",
              "src/app/core/services/theme.ts",
              "src/app/core/guards/*.ts",
              "src/app/core/interceptors/*.ts",
              "src/app/core/shared/utils/*.ts"
            ],
            "coverageExclude": [
              "src/app/**/*.spec.ts",
              "src/app/**/*.test.ts",
              "src/app/**/*.model.ts",
              "src/app/**/*.types.ts",
              "src/app/core/shared/types/**",
              "src/app/app.config*.ts",
              "src/app/app.routes.ts",
              "src/app/main*.ts",
              "src/app/server.ts"
            ],
            "coverageThresholds": {
              "statements": 10,
              "branches": 10,
              "functions": 1,
              "lines": 8
            },
            "providersFile": "src/test-providers.ts",
            "setupFiles": [
              "src/test-setup.ts"
            ]
          }
        }
      }
    }
  }
}
